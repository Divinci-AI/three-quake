{
	"imports": {
		"three": "./server/browser_shim.js"
	},
	"tasks": {
		"server": "deno run --allow-net --allow-read --unstable-net game_server.js",
		"brain": "deno run --allow-net --allow-env --allow-read=npc-brain npc-brain/main.ts",
